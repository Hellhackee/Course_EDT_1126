
#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары
 
&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = "Изменилась цена";
	
	ПересчитатьСумму(ТекстСообщения, ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = "Изменилась цена";
	
	ПересчитатьСумму(ТекстСообщения, ТекущиеДанные);
	
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаКлиенте
Процедура ПересчитатьСумму(СообщениеПользователю, СтрокаТовары)
	
	СтрокаТовары.Сумма = СтрокаТовары.Цена * СтрокаТовары.Количество;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = (СообщениеПользователю);
	Сообщение.Сообщить();

	
	Пользователь = ОписаниеПользователя();
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = (Пользователь.Имя);
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаКлиенте
Функция ОписаниеПользователя()
	Человек = Новый Структура;
	Человек.Вставить("Имя", "Андрей");
	Человек.Вставить("ДатаРождения", ТекущаяДата());
	Человек.Вставить("Штатный", Истина);
	Человек.Вставить("Стаж", 10);

	Возврат Человек;
КонецФункции
#КонецОбласти







